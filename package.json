{
  "name": "openapi-tool",
  "productName": "openapi-tool",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".rsbuild/build/main.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env MODE=dev electron-forge start --inspect-electron",
    "build:dev": "cross-env MODE=dev electron-forge publish",
    "build": "cross-env MODE=production electron-forge publish",
    "buildWeb": "cross-env MODE=production rsbuild build --config rsbuild.renderer.config.ts",
    "doctor": "RSDOCTOR=true npm run buildWeb",
    "lint": "eslint --ext .ts,.tsx ./src",
    "fix": "eslint --fix --ext .ts,.tsx ./src",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.5.0",
    "@electron-forge/publisher-github": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "@rsbuild/core": "^1.1.6",
    "@rsbuild/plugin-react": "^1.0.7",
    "@rsdoctor/rspack-plugin": "^0.4.8",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@types/debug": "^4.1.12",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/express": "^5.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "debug": "^4.3.7",
    "electron": "33.2.0",
    "electron-installer-dmg": "^5.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "eslint": "^8.0.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.25.0",
